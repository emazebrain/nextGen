  },
  "dependencies": {
    "@emb/game-sdk": "workspace:*",
    "pixi.js": "^8.9.0"
  },
  "devDependencies": {
    "@twemoji/svg": "15.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
