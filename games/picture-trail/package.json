{
  "name": "@emb/game-picture-trail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Picture Trail (spec 2026-11-10): pictures appear one at a time along a line, then find the one you saw. Imports only @emb/game-sdk and its renderer.",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
