{
  "name": "@emb/game-echo-keys",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Echo Keys (design doc §8.4): tap each piano key as its note arrives; leave the no-go balls alone. Imports only @emb/game-sdk and its renderer.",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness": "vite harness --port 4802"
  },
  "dependencies": {
    "@emb/game-sdk": "workspace:*",
    "pixi.js": "^8.9.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
