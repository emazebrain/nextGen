{
  "name": "@emb/game-beep-beep",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Beep Beep (design doc §8.4): slide the vehicles to free the hero. Imports only @emb/game-sdk and its renderer.",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "node --experimental-strip-types scripts/generate-pack.ts",
    "harness": "vite harness --port 4801"
  },
  "dependencies": {
    "@emb/game-sdk": "workspace:*",
    "pixi.js": "^8.9.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
